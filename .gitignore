# --- Java / Maven ---
target/
*.class
.mvn/wrapper/maven-wrapper.jar

# --- Node ---
node_modules/
dist/
.vite/
*.tsbuildinfo

# --- Quality tooling output (Task 13) ---
# Coverage reports and the Sonar scanner's working directory are generated on
# demand and are never committed. The configuration that produces them
# (sonar-project.properties, the Maven coverage profile) is tracked.
coverage/
.scannerwork/
.sonar/

# --- Environment files ---
.env
.env.local
.env.*.local
# Local Compose overrides, if a developer keeps them under this name rather
# than copying the example to .env. compose.yaml, the Dockerfiles, the
# .dockerignore files and .env.compose.example are all tracked deliberately.
.env.compose
!.env.example
!.env.compose.example

# --- IDE ---
.idea/
*.iml
*.ipr
*.iws
.vscode/
.classpath
.project
.settings/
.apt_generated/
.factorypath

# --- Logs and temporary files ---
*.log
logs/
npm-debug.log*
yarn-error.log*

# --- macOS ---
.DS_Store

# --- AI coding agent instructions (kept local, not shared via the repo) ---
AGENTS.md
CLAUDE.md
.claude/

# --- Kubernetes / EKS runtime secrets ---
# The real Secret is built at deploy time from AWS Secrets Manager and must
# never be committed. k8s/secret.example.yaml is deliberately NOT ignored: it
# holds placeholders only and documents the required keys.
.env.eks
k8s/secret.yaml
k8s/secrets.local.yaml
k8s/*.local.yaml
