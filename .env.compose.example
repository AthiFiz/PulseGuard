# PulseGuard — Docker Compose environment overrides
#
# ---------------------------------------------------------------------------
# You do not need this file to run PulseGuard.
# ---------------------------------------------------------------------------
#
# Every value below is already the built-in default in compose.yaml, so
#
#     docker compose up -d --build
#
# works on a fresh clone with no setup at all. This file exists to document
# what can be changed and to give you a starting point when something on your
# machine collides with a default.
#
# To use it:
#
#     cp .env.compose.example .env
#
# Compose reads a file named .env from the repository root automatically. That
# name is already in .gitignore, so your local edits stay local.
#
# ---------------------------------------------------------------------------
# DEVELOPMENT CREDENTIALS ONLY
# ---------------------------------------------------------------------------
# The passwords and the JWT secret here are throwaway values for a laptop.
# They are committed on purpose so the stack starts with no setup, and they are
# not deployment credentials — nothing in AWS should ever see them. Real
# secrets arrive with the deployment stages and come from a secret store, not
# from a file in the repository.


# --- MySQL -----------------------------------------------------------------

MYSQL_ROOT_PASSWORD=pulseguard_root_dev
MYSQL_DATABASE=pulseguard
# The application user. No PulseGuard service connects as root.
MYSQL_USER=pulseguard
MYSQL_PASSWORD=pulseguard_dev

# Host port for the Compose database. 3307 rather than 3306 so it cannot
# collide with a MySQL server already installed on your machine.
# Containers still reach it at mysql:3306.
MYSQL_HOST_PORT=3307


# --- Kafka -----------------------------------------------------------------

# Host port for the external listener. 19092 rather than 9092 so it cannot
# collide with a locally installed broker.
# Containers still reach it at kafka:29092.
KAFKA_HOST_PORT=19092

# KRaft cluster identity. Changing this on an existing kafka_data volume will
# be rejected by the broker — the id is recorded in the log directory. Change
# it only together with `docker compose down -v`.
KAFKA_CLUSTER_ID=ieFOxL_TTTi1uB7hKr9Q7Q


# --- Control API -----------------------------------------------------------

CONTROL_API_PORT=8080

# DEVELOPMENT ONLY. Generate your own with: openssl rand -base64 32
# Supplied at runtime, never baked into the image.
JWT_SECRET=7/YrZhvu3Czj1vFr94+MH8aRu5DBzMJL/82TT9BO6XI=

# CORS origin for browsers that are NOT going through the Compose frontend —
# a Vite dev server on the host, for example. The Dockerised frontend proxies
# /api through nginx and is same-origin, so it needs no entry here. Keep this a
# specific origin; do not set it to "*".
FRONTEND_ORIGIN=http://localhost:5173


# --- Monitor Worker --------------------------------------------------------

MONITOR_WORKER_PORT=8081

# DEVELOPMENT ONLY.
#
# Everything inside a Compose network has a private address, so the SSRF
# protection that guards a deployed PulseGuard would block every target that
# exists here — including demo-target and control-api. Setting this true is
# what makes monitoring a Docker-internal service possible.
#
# It must never be true in a deployed environment: it would let anyone who can
# create a monitor point PulseGuard at internal infrastructure. Cloud metadata
# endpoints (169.254.169.254 and friends) stay blocked either way — that rule
# is unconditional and this flag does not reach it.
MONITOR_ALLOW_PRIVATE_ADDRESSES=true


# --- Notification Service --------------------------------------------------

NOTIFICATION_SERVICE_PORT=8082

MAIL_FROM=pulseguard@localhost

# The base URL written into incident links in outgoing email. This is a
# browser-facing address: the reader opens it from the host, so it must not be
# a Docker service name.
FRONTEND_BASE_URL=http://localhost:5173


# --- Frontend --------------------------------------------------------------

# Kept at 5173, the same port the Vite dev server uses, so links and bookmarks
# survive switching between the two workflows.
FRONTEND_PORT=5173


# --- Mailpit ---------------------------------------------------------------

MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025


# --- Optional profiles -----------------------------------------------------

# --profile tools
KAFKA_UI_PORT=8090

# --profile demo
DEMO_TARGET_PORT=8088
